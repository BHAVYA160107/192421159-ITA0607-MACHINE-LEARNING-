      "source": [
        "import numpy as np\n",
        "# Input values\n",
        "x = np.array([-5, -2, 0, 2, 5])\n",
        "# Apply Sigmoid activation function\n",
        "sigmoid_output = 1 / (1 + np.exp(-x))\n",
        "print(\"Input Values:\")\n",
        "print(x)\n",
        "print(\"\\nSigmoid Output:\")\n",
        "print(sigmoid_output)\n"
      ],
