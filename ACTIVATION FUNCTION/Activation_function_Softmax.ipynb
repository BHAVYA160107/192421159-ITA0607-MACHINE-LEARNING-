      "source": [
        "import numpy as np\n",
        "marks = np.array([85, 70, 60])\n",
        "softmax = np.exp(marks) / np.sum(np.exp(marks))\n",
        "print(\"Scores :\", marks)\n",
        "print(\"Softmax:\", softmax)\n"
      ],
